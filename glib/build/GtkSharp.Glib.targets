<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <GtkSharpGlibNativePath>$(MSBuildThisFileDirectory)../runtimes/win-x64/native/</GtkSharpGlibNativePath>
  </PropertyGroup>

  <Target Name="CopyGtkSharpGlibNativeLibraries" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <GlibNativeDlls Include="$(GtkSharpGlibNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GlibNativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyGtkSharpGlibNativeLibrariesOnPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <GlibNativeDlls Include="$(GtkSharpGlibNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GlibNativeDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
