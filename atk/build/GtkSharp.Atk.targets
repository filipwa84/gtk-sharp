<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <GtkSharpAtkNativePath>$(MSBuildThisFileDirectory)../runtimes/win-x64/native/</GtkSharpAtkNativePath>
  </PropertyGroup>

  <Target Name="CopyGtkSharpAtkNativeLibraries" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <AtkNativeDlls Include="$(GtkSharpAtkNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AtkNativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyGtkSharpAtkNativeLibrariesOnPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <AtkNativeDlls Include="$(GtkSharpAtkNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(AtkNativeDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
