<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <GtkSharpCairoNativePath>$(MSBuildThisFileDirectory)../runtimes/win-x64/native/</GtkSharpCairoNativePath>
  </PropertyGroup>

  <Target Name="CopyGtkSharpCairoNativeLibraries" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <CairoNativeDlls Include="$(GtkSharpCairoNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CairoNativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyGtkSharpCairoNativeLibrariesOnPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <CairoNativeDlls Include="$(GtkSharpCairoNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CairoNativeDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
