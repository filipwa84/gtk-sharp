<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>gtk-dotnet</AssemblyName>
    <RootNamespace>GtkDotNet</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>GTK_SHARP_2_6;GTK_SHARP_2_8;GTK_SHARP_2_10;GTK_SHARP_2_12</DefineConstants>
    <NoWarn>0618;0649;0169;0414;0612;1616;1699;1504</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>GtkSharp.GtkDotNet</PackageId>
    <Version>2.12.57</Version>
    <Authors>filipwa84</Authors>
    <Company>filipwa84</Company>
    <Description>GTK.NET - .NET interop utilities for GTK#. Part of GTK# for .NET 9.</Description>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/filipwa84/gtk-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/filipwa84/gtk-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gtk;dotnet;interop;linux</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="obj/**;bin/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../glib/glib-sharp.net9.csproj" />
    <ProjectReference Include="../gdk/gdk-sharp.net9.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <None Include="gtk-dotnet.dll.config" Pack="true" PackagePath="build/net9.0" />
  </ItemGroup>

</Project>
