<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <GtkSharpPangoNativePath>$(MSBuildThisFileDirectory)../runtimes/win-x64/native/</GtkSharpPangoNativePath>
  </PropertyGroup>

  <Target Name="CopyGtkSharpPangoNativeLibraries" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <PangoNativeDlls Include="$(GtkSharpPangoNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PangoNativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyGtkSharpPangoNativeLibrariesOnPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <PangoNativeDlls Include="$(GtkSharpPangoNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PangoNativeDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
