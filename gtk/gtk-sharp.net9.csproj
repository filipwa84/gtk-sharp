<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>gtk-sharp</AssemblyName>
    <RootNamespace>Gtk</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>GTK_SHARP_2_6;GTK_SHARP_2_8;GTK_SHARP_2_10;GTK_SHARP_2_12</DefineConstants>
    <NoWarn>0618;0649;0169;0414;0612;1616;1699;1504</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>GtkSharp.Gtk</PackageId>
    <Version>2.12.61</Version>
    <Authors>filipwa84</Authors>
    <Company>filipwa84</Company>
    <Description>GTK# - .NET bindings for the GTK+ 2.x widget toolkit. Part of GTK# for .NET 9.</Description>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/filipwa84/gtk-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/filipwa84/gtk-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gtk;widgets;dotnet;linux;desktop;gui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="obj/**;bin/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../glib/glib-sharp.net9.csproj" />
    <ProjectReference Include="../cairo/cairo-sharp.net9.csproj" />
    <ProjectReference Include="../pango/pango-sharp.net9.csproj" />
    <ProjectReference Include="../gdk/gdk-sharp.net9.csproj" />
    <ProjectReference Include="../atk/atk-sharp.net9.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <None Include="gtk-sharp.dll.config" Pack="true" PackagePath="build/net9.0" />
    <None Include="build/GtkSharp.Gtk.targets" Pack="true" PackagePath="build" />
    <None Include="build/GtkSharp.Gtk.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <!-- Native libraries for Windows and Linux -->
  <ItemGroup>
    <None Include="runtimes/win-x64/native/**/*" Pack="true" PackagePath="runtimes/win-x64/native" />
    <None Include="runtimes/linux-x64/native/**/*" Pack="true" PackagePath="runtimes/linux-x64/native" />
  </ItemGroup>

</Project>
