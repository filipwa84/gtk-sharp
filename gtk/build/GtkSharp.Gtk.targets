<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Define the source path for native libraries -->
  <PropertyGroup>
    <GtkSharpNativePath>$(MSBuildThisFileDirectory)../runtimes/win-x64/native/</GtkSharpNativePath>
  </PropertyGroup>

  <!-- Windows: Copy native DLLs to output directory after build -->
  <Target Name="CopyGtkSharpNativeLibraries" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <GtkNativeDlls Include="$(GtkSharpNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GtkNativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Also copy on publish -->
  <Target Name="CopyGtkSharpNativeLibrariesOnPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <GtkNativeDlls Include="$(GtkSharpNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GtkNativeDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
