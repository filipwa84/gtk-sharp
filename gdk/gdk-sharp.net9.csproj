<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>gdk-sharp</AssemblyName>
    <RootNamespace>Gdk</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>GTK_SHARP_2_6;GTK_SHARP_2_8;GTK_SHARP_2_10;GTK_SHARP_2_12</DefineConstants>
    <NoWarn>0618;0649;0169;0414;0612;1616;1699;1504</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>GtkSharp.Gdk</PackageId>
    <Version>2.12.50</Version>
    <Authors>filipwa84</Authors>
    <Company>filipwa84</Company>
    <Description>GDK# - .NET bindings for the GDK windowing library. Part of GTK# for .NET 9.</Description>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/filipwa84/gtk-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/filipwa84/gtk-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gtk;gdk;windowing;dotnet;linux;desktop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="obj/**;bin/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../glib/glib-sharp.net9.csproj" />
    <ProjectReference Include="../cairo/cairo-sharp.net9.csproj" />
    <ProjectReference Include="../pango/pango-sharp.net9.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <None Include="gdk-sharp.dll.config" Pack="true" PackagePath="build/net9.0" />
  </ItemGroup>

</Project>
