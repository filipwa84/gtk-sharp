<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <GtkSharpGdkNativePath>$(MSBuildThisFileDirectory)../runtimes/win-x64/native/</GtkSharpGdkNativePath>
  </PropertyGroup>

  <Target Name="CopyGtkSharpGdkNativeLibraries" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <GdkNativeDlls Include="$(GtkSharpGdkNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GdkNativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyGtkSharpGdkNativeLibrariesOnPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <GdkNativeDlls Include="$(GtkSharpGdkNativePath)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GdkNativeDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
